{
  "manifest_version": 3,
  "name": "YouTube Focus Mode",
  "version": "1.0.0",
  "description": "Hide algorithmic recommendations, Shorts, and autoplay so YouTube only shows the channels you follow.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "YouTube Focus Mode",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "exclude_matches": ["*://music.youtube.com/*"],
      "js": ["content/content-script.js"],
      "css": ["content/focus-mode.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": ["storage", "alarms"],
  "host_permissions": ["*://*.youtube.com/*"],
  "commands": {
    "toggle-focus-mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Toggle YouTube Focus Mode on/off"
    }
  },
  "minimum_chrome_version": "110"
}
